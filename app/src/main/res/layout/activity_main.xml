<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- Thông tin sinh viên -->
    <TextView
        android:id="@+id/tvThongTinSinhVien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SV: Nguyễn Phan Hồng Ngọc\nMSV: [Điền MSV]\nLớp HP: [Điền Lớp]"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Ô nhập tên công việc -->
    <EditText
        android:id="@+id/edtTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên công việc"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Ô nhập mô tả công việc -->
    <EditText
        android:id="@+id/edtMoTaCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mô tả công việc"
        android:inputType="textMultiLine"
        android:lines="3"
        android:layout_marginBottom="20dp" />

    <!-- Nút Tạo công việc -->
    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tạo công việc"
        android:layout_marginBottom="12dp" />

    <!-- Nút Xem danh sách -->
    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem danh sách công việc" />
</LinearLayout>